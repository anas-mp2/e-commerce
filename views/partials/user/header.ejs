<div class="navbar">
    <div class="logo">
        <img src="/images/ecommerce_logo-removebg.png" alt="Logo" />
    </div>
    <div class="nav-items">
        <a href="/products">Home</a>
        <a href="#">Contact</a>
        <a href="#">About</a>
        <% if (session && session.user) { %>
            <a href="/logout" class="logout-btn">Logout</a>
        <% } else { %>
            <a href="/user/login" class="login-btn">Login</a>
            <a href="/signup" class="signup-btn">Signup</a>
        <% } %>
        <div class="search">
            <input type="text" placeholder="Search..." />
            <button>🔍</button>
        </div>
    </div>
</div>