<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify Email OTP</title>
    <link rel="stylesheet" href="/styles/style.css">
</head>
<body>
    <%- include('../partials/user/header') %>
    <div class="otp-container">
        <h1>Verify New Email</h1>
        <p>Enter the OTP sent to your new email address.</p>
        <form id="verifyEmailOtpForm">
            <div class="form-group">
                <label for="otp">OTP:</label>
                <input type="text" id="otp" name="otp" required>
            </div>
            <button type="submit" class="btn">Verify</button>
            <button type="button" id="resendOtp" class="btn">Resend OTP</button>
        </form>
        <p id="error" class="error-message"></p>
        <p id="success" style="color: green;"></p>
    </div>
    <footer>
        <%- include('../partials/user/footer') %>
    </footer>
    <script src="/script/verify-email-otp.js"></script>
</body>
</html>