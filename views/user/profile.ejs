<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Profile - Sneakify E-commerce</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="/styles/style.css">
    <style>
        body {
            background-color: #f4f4f4;
            margin: 0;
            font-family: Arial, sans-serif;
            background: url('https://images.unsplash.com/photo-1600585154526-990d71bee1e5?ixlib=rb-4.0.3&auto=format&fit=crop&w=1350&q=80') no-repeat center center fixed;
            background-size: cover;
            color: #333;
        }
        body.no-background {
            background: url('https://images.unsplash.com/photo-1542291026-7eec264c27ff?ixlib=rb-4.0.3&auto=format&fit=crop&w=1350&q=80') no-repeat center center fixed;
            background-size: cover;
        }
        header {
            background-color: #2c2c2c;
            padding: 10px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        header img.logo {
            height: 40px;
        }
        nav a {
            color: #fff;
            margin: 0 15px;
            text-decoration: none;
            font-size: 16px;
        }
        nav a:hover {
            color: #DB4444;
        }
        .logout-btn {
            background-color: #DB4444;
            color: #fff;
            border: none;
            padding: 8px 15px;
            border-radius: 5px;
            cursor: pointer;
            transition: background 0.3s;
        }
        .logout-btn:hover {
            background-color: #c82333;
        }
        .search-bar {
            padding: 5px;
            width: 200px;
            border-radius: 5px;
            border: 1px solid #ccc;
        }
        .profile-container {
            max-width: 90%;
            width: 80%;
            margin: 20px auto;
            padding: 20px;
            background: rgba(255, 255, 255, 0.9);
            border-radius: 15px;
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
            backdrop-filter: blur(5px);
        }
        .profile-section {
            margin-bottom: 30px;
            border-bottom: 2px solid #DB4444;
            padding-bottom: 15px;
        }
        .profile-section h2 {
            color: #DB4444;
            font-size: 1.8em;
            margin-bottom: 15px;
            font-weight: 600;
        }
        .profile-details {
            display: flex;
            align-items: flex-start;
            gap: 20px;
        }
        .profile-details img.profile-pic {
            max-width: 150px;
            border-radius: 50%;
            border: 4px solid #1d3557;
            margin-bottom: 15px;
            transition: transform 0.3s;
        }
        .profile-details img.profile-pic:hover {
            transform: scale(1.05);
        }
        .profile-details .user-info {
            flex-grow: 1;
            margin-right: 20px;
        }
        .profile-details p {
            margin: 10px 0;
            font-size: 1.1em;
            color: #1d3557;
            line-height: 1.5;
        }
        .btn-custom {
            background-color: #DB4444;
            color: #fff;
            padding: 10px 25px;
            border: none;
            border-radius: 25px;
            text-decoration: none;
            font-size: 1em;
            margin: 10px 10px 0 0;
            display: inline-block;
            min-width: 140px;
            text-align: center;
            transition: all 0.3s ease;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
        .btn-custom:hover {
            background-color: #c82333;
            transform: translateY(-2px);
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.2);
        }
        .btn-address {
            background-color: #28a745;
            border-radius: 25px;
        }
        .btn-address:hover {
            background-color: #218838;
        }
        .address {
            background: rgba(255, 255, 255, 0.8);
            padding: 15px;
            margin: 10px 0;
            border-left: 6px solid #28a745;
            border-radius: 10px;
            display: flex;
            justify-content: flex-start;
            align-items: center;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }
        .address p {
            margin: 0;
            font-size: 1em;
            color: #1d3557;
            flex-grow: 1;
        }
        .no-data {
            color: #666;
            font-style: italic;
            text-align: center;
            font-size: 1.1em;
            padding: 20px;
            background: rgba(255, 255, 255, 0.7);
            border-radius: 10px;
        }
        table {
            width: 100%;
            margin-top: 10px;
            border-radius: 10px;
            overflow: hidden;
        }
        th {
            background-color: #1d3557;
            color: #fff;
            padding: 12px;
        }
        .cancel-btn {
            background-color: #dc3545;
            color: #fff;
            padding: 6px 12px;
            border: none;
            border-radius: 20px;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        .cancel-btn:hover {
            background-color: #c82333;
            transform: translateY(-2px);
        }
        @media (max-width: 768px) {
            .profile-container {
                width: 95%;
            }
            .profile-details {
                flex-direction: column;
                align-items: center;
                text-align: center;
            }
            .profile-details .user-info {
                margin-right: 0;
            }
            .btn-custom {
                width: 100%;
                margin: 5px 0;
            }
            .address {
                flex-direction: column;
                text-align: left;
            }
        }
    </style>
</head>
<body>
    
    <%- include('../partials/user/header') %>

    <div class="profile-container">
        <div class="profile-section">
            <h2>Personal Details</h2>
            <div class="profile-details">
                <% if (user.profilePicture) { %>
                    <img src="<%= user.profilePicture %>" alt="Profile Picture" class="profile-pic" onerror="this.src='https://via.placeholder.com/150';">
                <% } else { %>
                    <img src="https://via.placeholder.com/150" alt="Default Profile Picture" class="profile-pic">
                <% } %>
                <div class="user-info">
                    <p><strong>Name:</strong> <%= user.name %></p>
                    <p><strong>Email:</strong> <%= user.email %></p>
                    <p><strong>Phone:</strong> <%= user.phone || 'Not provided' %></p>
                    <a href="/edit-profile" class="btn-custom">Edit Profile</a>
                    <a href="/change-password" class="btn-custom">Change Password</a>
                </div>
            </div>
        </div>

        <div class="profile-section">
            <h2>Addresses</h2>
            <div class="profile-details">
                <% if (user.addresses && user.addresses.length > 0) { %>
                    <% user.addresses.forEach(address => { %>
                        <div class="address">
                            <p><%= address.street %>, <%= address.city %>, <%= address.state %>, <%= address.zip %>, <%= address.country %></p>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p class="no-data">No addresses added.</p>
                <% } %>
                <% if (!user.addresses || user.addresses.length === 0) { %>
                    <a href="/add-address" class="btn-custom btn-address">Add Address</a>
                <% } %>
            </div>
        </div>

        <div class="profile-section">
            <h2>Order History</h2>
            <div class="profile-details">
                <% if (orders && orders.length > 0) { %>
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Order ID</th>
                                <th>Date</th>
                                <th>Total</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% orders.forEach(order => { %>
                                <tr>
                                    <td><%= order._id %></td>
                                    <td><%= order.createdAt.toDateString() %></td>
                                    <td>$<%= order.totalAmount.toFixed(2) %></td>
                                    <td><%= order.status %></td>
                                    <td>
                                        <% if (order.status === 'Pending' || order.status === 'Processing') { %>
                                            <button class="cancel-btn btn-sm" data-order-id="<%= order._id %>">Cancel</button>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                <% } else { %>
                    <p class="no-data">No orders placed yet.</p>
                <% } %>
            </div>
        </div>
    </div>


    <%- include('../partials/user/footer') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>