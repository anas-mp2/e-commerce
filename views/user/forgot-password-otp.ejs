<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OTP Verification</title>
    <link rel="stylesheet" href="/styles/verify-otp.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>
<body>
    <form action="/verify-forgot-password-otp" onsubmit="return validateOTPForm()" method="post">
        <div class="container">
            <h1>OTP Verification</h1>
            <p>Enter the 6-digit code sent to your device</p>
            <div id="timer">Time remaining: 3:00</div>
            <div class="otp-input">
                <input class="otp" name="otp[]" type="number" required>
                <input class="otp" name="otp[]" type="number" required>
                <input class="otp" name="otp[]" type="number" required>
                <input class="otp" name="otp[]" type="number" required>
                <input class="otp" name="otp[]" type="number" required>
                <input class="otp" name="otp[]" type="number" required>
            </div>
            <p style="color: red;"><%= message %></p>
            <button type="submit">Verify</button>
            <form action="/resend-forgot-password-otp" onsubmit="return resendOTP(event)" method="post">
                <button type="submit" id="resendButton" disabled>Resend Code</button>
            </form>
        </div>
    </form>
    <script src="/script/forgot-password.js"></script>
</body>
</html>