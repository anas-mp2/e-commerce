<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - Add Product</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.css">
    <link rel="stylesheet" href="/styles/adminStyles/dashboard.css">
    <link rel="stylesheet" href="/styles/adminStyles/users.css">
    <style>
        .form-container {
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
            display: flex;
            flex-direction: column;
        }
        .form-control, .form-select {
            background-color: #1F2A44;
            color: #fff;
            border-color: #2A3555;
        }
        .form-control:focus, .form-select:focus {
            background-color: #1F2A44;
            color: #fff;
            border-color: #007bff;
            box-shadow: none;
        }
        .btn-primary {
            background-color: #007bff;
            color: white;
            border: none;
            padding: 5px 15px;
        }
        .btn-primary:hover {
            background-color: #0056b3;
            border-color: #0056b3;
        }
        .alert {
            background-color: #2A3555;
            color: #fff;
            border: none;
        }
        .product-image {
            max-width: 100px;
            margin: 5px;
            border: 1px solid #2A3555;
        }
        .cropper-container {
            max-width: 100%;
            max-height: 600px;
            margin-bottom: 40px;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
            position: relative;
        }
        .image-preview {
            max-width: 100%;
            max-height: 500px;
            margin: 10px 0;
            display: block;
        }
        .image-section {
            margin-bottom: 100px;
            min-height: 200px;
        }
        .submit-section {
            margin-top: 50px;
            display: flex;
            justify-content: flex-start;
            position: relative;
            z-index: 1;
        }
        #cropAllButton {
            margin-top: 10px;
            display: none;
        }
        .delete-icon {
            position: absolute;
            top: 15px;
            right: 15px;
            background-color: #dc3545;
            color: white;
            width: 30px;
            height: 30px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 16px;
            z-index: 10;
        }
        .delete-icon:hover {
            background-color: #c82333;
        }
        .modal-content {
            background-color: #1F2A44;
            color: #fff;
        }
        .modal-header, .modal-footer {
            border-color: #2A3555;
        }
    </style>
</head>
<body>
    <div class="d-flex">
        <!-- Sidebar -->
        <div class="sidebar">
            <%- include('../partials/admin/sidebar') %>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            <div class="navbar">
                <%- include('../partials/admin/navbar') %>
            </div>
            
            <div class="container-fluid custom-container">
                <div class="form-container">
                    <h2 class="text-white mb-4">Add New Product</h2>
                    <% if (message) { %>
                        <div class="alert alert-danger"><%= message %></div>
                    <% } %>
                    <form id="addProductForm" action="/admin/products/add" method="POST" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label for="name" class="form-label text-white">Product Name</label>
                            <input type="text" class="form-control" id="name" name="name" required>
                        </div>
                        <div class="mb-3">
                            <label for="description" class="form-label text-white">Description</label>
                            <textarea class="form-control" id="description" name="description" required></textarea>
                        </div>
                        <div class="mb-3">
                            <label for="brand" class="form-label text-white">Brand</label>
                            <input type="text" class="form-control" id="brand" name="brand" required>
                        </div>
                        <div class="mb-3">
                            <label for="price" class="form-label text-white">Price</label>
                            <input type="number" class="form-control" id="price" name="price" min="0" step="0.01" required>
                        </div>
                        <div class="mb-3">
                            <label for="stock" class="form-label text-white">Stock</label>
                            <input type="number" class="form-control" id="stock" name="stock" min="0" required>
                        </div>
                        <div class="mb-3">
                            <label for="category" class="form-label text-white">Category</label>
                            <select class="form-select" id="category" name="category" required>
                                <% categories.forEach(category => { %>
                                    <option value="<%= category._id %>"><%= category.description || 'N/A' %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="status" class="form-label text-white">Status</label>
                            <select class="form-select" id="status" name="status" required>
                                <option value="Active">Active</option>
                                <option value="Inactive">Inactive</option>
                            </select>
                        </div>
                        <div class="mb-3 image-section">
                            <label for="images" class="form-label text-white">Product Images (Minimum 3)</label>
                            <input type="file" class="form-control" id="images" name="images" multiple accept="image/*">
                            <div id="imagePreview" class="mt-3"></div>
                            <button id="cropAllButton" class="btn btn-success">Crop All</button>
                        </div>
                        <div class="submit-section">
                            <button type="submit" class="btn btn-primary">Add Product</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Price Zero Modal -->
    <div class="modal fade" id="priceZeroModal" tabindex="-1" aria-labelledby="priceZeroModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="priceZeroModalLabel">Invalid Price</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    Price cannot be 0. Please enter a valid price.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Crop Incomplete Modal -->
    <div class="modal fade" id="cropIncompleteModal" tabindex="-1" aria-labelledby="cropIncompleteModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="cropIncompleteModalLabel">Incomplete Action</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    Please crop all images before submitting.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.js"></script>
    <script>
        const imageInput = document.getElementById('images');
        const imagePreview = document.getElementById('imagePreview');
        const form = document.getElementById('addProductForm');
        const cropAllButton = document.getElementById('cropAllButton');
        const priceInput = document.getElementById('price');
        const priceZeroModal = new bootstrap.Modal(document.getElementById('priceZeroModal'));
        const cropIncompleteModal = new bootstrap.Modal(document.getElementById('cropIncompleteModal'));
        let croppers = [];
        let croppedBlobs = [];
        let isCroppingComplete = false;
        let filesArray = [];

        // Update file input to reflect current files
        function updateFileInput() {
            const dataTransfer = new DataTransfer();
            filesArray.forEach(file => dataTransfer.items.add(file));
            imageInput.files = dataTransfer.files;
        }

        imageInput.addEventListener('change', (event) => {
            const files = event.target.files;
            imagePreview.innerHTML = '';
            croppers = [];
            croppedBlobs = [];
            isCroppingComplete = false;
            filesArray = Array.from(files);
            cropAllButton.style.display = 'none';

            if (filesArray.length > 0 && filesArray.length < 3) {
                alert('Please upload at least 3 images.');
                imageInput.value = '';
                filesArray = [];
                return;
            }

            filesArray.forEach((file, index) => {
                const reader = new FileReader();
                reader.onload = (e) => {
                    const imgContainer = document.createElement('div');
                    imgContainer.className = 'cropper-container';

                    const img = document.createElement('img');
                    img.src = e.target.result;
                    img.className = 'image-preview';
                    img.id = `image-${index}`;
                    img.style.width = '100%';
                    imgContainer.appendChild(img);

                    const deleteIcon = document.createElement('span');
                    deleteIcon.className = 'delete-icon';
                    deleteIcon.innerHTML = '✖';
                    deleteIcon.dataset.index = index;
                    deleteIcon.addEventListener('click', () => {
                        imgContainer.remove();
                        croppers[index] = null;
                        croppedBlobs[index] = null;
                        filesArray[index] = null;
                        filesArray = filesArray.filter(file => file !== null);
                        croppers = croppers.filter(cropper => cropper !== null);
                        croppedBlobs = croppedBlobs.filter(blob => blob !== null);
                        updateFileInput();
                        if (filesArray.length < 3 && filesArray.length > 0) {
                            alert('Please ensure at least 3 images are uploaded.');
                        }
                        cropAllButton.style.display = filesArray.length >= 3 ? 'block' : 'none';
                    });
                    imgContainer.appendChild(deleteIcon);

                    imagePreview.appendChild(imgContainer);

                    const cropper = new Cropper(img, {
                        aspectRatio: 1,
                        viewMode: 2,
                        autoCropArea: 0.8,
                        responsive: true,
                        minContainerWidth: 800,
                        minContainerHeight: 600,
                    });
                    croppers[index] = cropper;

                    if (index === 2 && filesArray.length >= 3) {
                        cropAllButton.style.display = 'block';
                    }
                };
                reader.readAsDataURL(file);
            });
        });

        cropAllButton.addEventListener('click', () => {
            croppedBlobs = [];
            let allCropped = true;

            croppers.forEach((cropper, index) => {
                if (cropper) {
                    const canvas = cropper.getCroppedCanvas({
                        width: 800,
                        height: 800,
                    });
                    if (canvas && canvas.width > 0 && canvas.height > 0) {
                        canvas.toBlob((blob) => {
                            croppedBlobs[index] = blob;
                            if (index === croppers.length - 1) {
                                isCroppingComplete = true;
                                alert('All images cropped successfully!');
                            }
                        }, 'image/jpeg');
                    } else {
                        allCropped = false;
                    }
                }
            });

            if (!allCropped) {
                alert('Please adjust the crop area for all images!');
                isCroppingComplete = false;
            }
        });

        form.addEventListener('submit', (event) => {
            const price = parseFloat(priceInput.value);
            if (price === 0) {
                event.preventDefault();
                priceZeroModal.show();
                return;
            }

            if (imageInput.files.length > 0) {
                if (!isCroppingComplete || croppedBlobs.length !== imageInput.files.length || croppedBlobs.some(blob => !blob)) {
                    event.preventDefault();
                    cropIncompleteModal.show();
                    return;
                }

                const dataTransfer = new DataTransfer();
                croppedBlobs.forEach((blob, index) => {
                    const file = new File([blob], `cropped-${index}.jpg`, { type: 'image/jpeg' });
                    dataTransfer.items.add(file);
                });
                imageInput.files = dataTransfer.files;
            }
        });
    </script>
</body>
</html>