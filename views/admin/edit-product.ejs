<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - Edit Product</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.css">
    <link rel="stylesheet" href="/styles/adminStyles/dashboard.css">
    <link rel="stylesheet" href="/styles/adminStyles/users.css">
    <style>
        .form-container {
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
            display: flex;
            flex-direction: column;
        }
        .form-control, .form-select {
            background-color: #1F2A44;
            color: #fff;
            border-color: #2A3555;
        }
        .form-control:focus, .form-select:focus {
            background-color: #1F2A44;
            color: #fff;
            border-color: #007bff;
            box-shadow: none;
        }
        .btn-primary {
            background-color: #007bff;
            color: white;
            border: none;
            padding: 5px 15px;
        }
        .btn-primary:hover {
            background-color: #0056b3;
            border-color: #0056b3;
        }
        .alert {
            background-color: #2A3555;
            color: #fff;
            border: none;
        }
        .product-image {
            max-width: 100px;
            margin: 5px;
            border: 1px solid #2A3555;
            position: relative;
            display: inline-block;
        }
        .image-preview {
            max-width: 200px;
            margin: 10px 0;
            display: block;
        }
        .cropper-container {
            max-width: 100%;
            max-height: 400px;
            margin-bottom: 40px;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
            position: relative;
        }
        .image-section {
            margin-bottom: 100px;
            min-height: 200px;
        }
        .submit-section {
            margin-top: 50px;
            display: flex;
            justify-content: flex-start;
            position: relative;
            z-index: 1;
        }
        .delete-icon {
            position: absolute;
            top: 5px;
            right: 5px;
            background-color: #dc3545;
            color: white;
            width: 25px;
            height: 25px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 14px;
            z-index: 10;
            line-height: 25px;
            text-align: center;
        }
        .delete-icon:hover {
            background-color: #c82333;
        }
        .hidden-input {
            display: none;
        }
        .modal-content {
            background-color: #1F2A44;
            color: #fff;
        }
        .modal-header, .modal-footer {
            border-color: #2A3555;
        }
    </style>
</head>
<body>
    <div class="d-flex">
        <!-- Sidebar -->
        <div class="sidebar">
            <%- include('../partials/admin/sidebar') %>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            <div class="navbar">
                <%- include('../partials/admin/navbar') %>
            </div>
            
            <div class="container-fluid custom-container">
                <div class="form-container">
                    <h2 class="text-white mb-4">Edit Product</h2>
                    <% if (message) { %>
                        <div class="alert alert-danger"><%= message %></div>
                    <% } %>
                    <form id="editProductForm" action="/admin/products/edit/<%= product._id %>" method="POST" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label for="name" class="form-label text-white">Product Name</label>
                            <input type="text" class="form-control" id="name" name="name" value="<%= product.name %>" required>
                        </div>
                        <div class="mb-3">
                            <label for="description" class="form-label text-white">Description</label>
                            <textarea class="form-control" id="description" name="description" required><%= product.description || '' %></textarea>
                        </div>
                        <div class="mb-3">
                            <label for="brand" class="form-label text-white">Brand</label>
                            <input type="text" class="form-control" id="brand" name="brand" value="<%= product.brand %>" required>
                        </div>
                        <div class="mb-3">
                            <label for="price" class="form-label text-white">Price</label>
                            <input type="number" class="form-control" id="price" name="price" min="0" step="0.01" value="<%= product.price %>" required>
                        </div>
                        <div class="mb-3">
                            <label for="stock" class="form-label text-white">Stock</label>
                            <input type="number" class="form-control" id="stock" name="stock" min="0" value="<%= product.stock %>" required>
                        </div>
                        <div class="mb-3">
                            <label for="status" class="form-label text-white">Status</label>
                            <select class="form-select" id="status" name="status" required>
                                <option value="Active" <%= product.status === 'Active' ? 'selected' : '' %>>Active</option>
                                <option value="Inactive" <%= product.status === 'Inactive' ? 'selected' : '' %>>Inactive</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="category" class="form-label text-white">Category</label>
                            <select class="form-select" id="category" name="category" required>
                                <% categories.forEach(category => { %>
                                    <option value="<%= category._id %>" <%= product.category._id.toString() === category._id.toString() ? 'selected' : '' %>><%= category.description || 'N/A' %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-white">Current Images</label>
                            <div id="currentImagesContainer">
                                <% product.images.forEach((image, index) => { %>
                                    <div class="product-image-container" style="display: inline-block; position: relative;">
                                        <img src="<%= image %>" alt="Product Image" class="product-image" data-index="<%= index %>">
                                        <span class="delete-icon" data-index="<%= index %>">✖</span>
                                    </div>
                                <% }) %>
                            </div>
                            <input type="hidden" id="deletedImages" name="deletedImages" value="">
                        </div>
                        <div class="mb-3 image-section">
                            <label for="images" class="form-label text-white">Upload New Images (Optional, Minimum 3 if uploading)</label>
                            <input type="file" class="form-control" id="images" name="images" multiple accept="image/*">
                            <div id="imagePreview" class="mt-3"></div>
                        </div>
                        <div class="submit-section">
                            <button type="submit" class="btn btn-primary">Update Product</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Price Zero Modal -->
    <div class="modal fade" id="priceZeroModal" tabindex="-1" aria-labelledby="priceZeroModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="priceZeroModalLabel">Invalid Price</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    Price cannot be 0. Please enter a valid price.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Crop Incomplete Modal -->
    <div class="modal fade" id="cropIncompleteModal" tabindex="-1" aria-labelledby="cropIncompleteModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="cropIncompleteModalLabel">Incomplete Action</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    Please crop all images before submitting.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.js"></script>
    <script>
        const imageInput = document.getElementById('images');
        const imagePreview = document.getElementById('imagePreview');
        const form = document.getElementById('editProductForm');
        const currentImagesContainer = document.getElementById('currentImagesContainer');
        const priceInput = document.getElementById('price');
        const priceZeroModal = new bootstrap.Modal(document.getElementById('priceZeroModal'));
        const cropIncompleteModal = new bootstrap.Modal(document.getElementById('cropIncompleteModal'));
        let croppers = [];
        let croppedBlobs = [];
        let filesArray = [];
        let deletedImages = [];

        // Update file input to reflect current files
        function updateFileInput() {
            const dataTransfer = new DataTransfer();
            filesArray.forEach(file => dataTransfer.items.add(file));
            imageInput.files = dataTransfer.files;
            console.log('Updated filesArray length:', filesArray.length);
        }

        // Event delegation for delete icons on current images
        currentImagesContainer.addEventListener('click', (e) => {
            if (e.target.classList.contains('delete-icon')) {
                const index = parseInt(e.target.getAttribute('data-index'));
                const imgContainer = e.target.closest('.product-image-container');
                if (imgContainer) {
                    imgContainer.remove();
                    deletedImages.push(product.images[index]);
                    document.getElementById('deletedImages').value = deletedImages.join(',');
                    console.log('Deleted image at index:', index, 'URL:', product.images[index]);
                }
            }
        });

        imageInput.addEventListener('change', (event) => {
            const files = event.target.files;
            imagePreview.innerHTML = '';
            croppers = [];
            croppedBlobs = [];
            filesArray = Array.from(files);

            if (filesArray.length > 0 && filesArray.length < 3) {
                alert('Please upload at least 3 images if updating images.');
                imageInput.value = '';
                filesArray = [];
                return;
            }

            filesArray.forEach((file, index) => {
                const reader = new FileReader();
                reader.onload = (e) => {
                    const imgContainer = document.createElement('div');
                    imgContainer.className = 'cropper-container';

                    const img = document.createElement('img');
                    img.src = e.target.result;
                    img.className = 'image-preview';
                    img.id = `image-${index}`;
                    img.style.width = '100%';
                    imgContainer.appendChild(img);

                    const deleteIcon = document.createElement('span');
                    deleteIcon.className = 'delete-icon';
                    deleteIcon.innerHTML = '✖';
                    deleteIcon.dataset.index = index;
                    deleteIcon.addEventListener('click', () => {
                        imgContainer.remove();
                        croppers[index] = null;
                        croppedBlobs[index] = null;
                        filesArray[index] = null;
                        filesArray = filesArray.filter(file => file !== null);
                        croppers = croppers.filter(cropper => cropper !== null);
                        croppedBlobs = croppedBlobs.filter(blob => blob !== null);
                        updateFileInput();
                        if (filesArray.length < 3 && filesArray.length > 0) {
                            alert('Please ensure at least 3 images are uploaded if updating images.');
                        }
                    });
                    imgContainer.appendChild(deleteIcon);

                    const cropButton = document.createElement('button');
                    cropButton.type = 'button';
                    cropButton.className = 'btn btn-primary';
                    cropButton.textContent = 'Crop Image';
                    cropButton.style.marginTop = '10px';
                    cropButton.style.alignSelf = 'flex-start';
                    cropButton.addEventListener('click', () => cropImage(index));
                    imgContainer.appendChild(cropButton);

                    imagePreview.appendChild(imgContainer);

                    const cropper = new Cropper(img, {
                        aspectRatio: 1,
                        viewMode: 1,
                        autoCropArea: 0.8,
                        responsive: true,
                    });
                    croppers[index] = cropper;
                    console.log('Added delete icon for image:', index);
                };
                reader.readAsDataURL(file);
            });
        });

        function cropImage(index) {
            const cropper = croppers[index];
            if (cropper) {
                cropper.getCroppedCanvas({
                    width: 800,
                    height: 800,
                }).toBlob((blob) => {
                    croppedBlobs[index] = blob;
                    alert('Image cropped successfully!');
                }, 'image/jpeg');
            }
        }

        form.addEventListener('submit', (event) => {
            const price = parseFloat(priceInput.value);
            if (price === 0) {
                event.preventDefault();
                priceZeroModal.show();
                return;
            }

            if (imageInput.files.length > 0) {
                if (croppedBlobs.length !== imageInput.files.length || croppedBlobs.some(blob => !blob)) {
                    event.preventDefault();
                    cropIncompleteModal.show();
                    return;
                }
                const dataTransfer = new DataTransfer();
                croppedBlobs.forEach((blob, index) => {
                    const file = new File([blob], `cropped-${index}.jpg`, { type: 'image/jpeg' });
                    dataTransfer.items.add(file);
                });
                imageInput.files = dataTransfer.files;
            }
            if (deletedImages.length > 0) {
                console.log('Submitting with deleted images:', deletedImages);
            }
        });
    </script>
</body>
</html>